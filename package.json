{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@9.6.0",
  "scripts": {
    "build": "nuxi build",
    "dev:pwa": "VITE_PLUGIN_PWA=true nuxi dev",
    "dev": "nuxi dev",
    "generate": "nuxi generate",
    "prepare": "nuxi prepare && npx simple-git-hooks",
    "start": "node .output/server/index.mjs",
    "start:generate": "npx serve .output/public",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "radix-vue": "^1.9.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2.24.0",
    "@iconify-json/carbon": "^1.1.36",
    "@iconify-json/twemoji": "^1.1.15",
    "@nuxt/devtools": "^1.3.9",
    "@nuxt/eslint": "^0.4.0",
    "@nuxtjs/color-mode": "^3.4.2",
    "@pinia/nuxt": "^0.5.2",
    "@unocss/eslint-config": "^0.61.8",
    "@unocss/nuxt": "^0.61.8",
    "@vite-pwa/nuxt": "^0.9.1",
    "@vueuse/nuxt": "^10.11.0",
    "consola": "^3.2.3",
    "eslint": "^9.8.0",
    "eslint-plugin-format": "^0.1.2",
    "lint-staged": "^15.2.7",
    "nuxt": "^3.12.4",
    "pinia": "^2.2.0",
    "simple-git-hooks": "^2.11.1",
    "typescript": "^5.5.4",
    "unocss": "^0.61.8",
    "unocss-preset-radix": "^2.5.5",
    "vue-tsc": "^2.0.29"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
